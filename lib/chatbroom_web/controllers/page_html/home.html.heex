<Layouts.app>
  <div class="mx-auto w-full max-w-[1140px] px-4 pt-4">
    <div class="mb-8 rounded-[0.3rem] bg-[#e9ecef] px-8 py-16">
      <h1 class="mb-2 text-[3.5rem] leading-tight font-light">Welcome to Chatbroom!</h1>
      <p class="text-xl font-light">
        Chatbroom has no users, no pre-created rooms, and no database.
      </p>
      <hr class="my-6 border-black/10" />
      <p>
        If you want to start up a chat, just head to
        <a href={~p"/rooms/whatever-you-like"} class={Layouts.link_class()}>
          /rooms/whatever-you-like
        </a>
        and a new room will be generated.
      </p>
    </div>

    <p>Some points of interest:</p>
    <ul class="mb-4 list-disc pl-10">
      <li>
        No history will be saved, not even locally.
        If you refresh the page, you'll lose the chat history.
      </li>
      <li>
        You'll be given a random username.
        If you refresh the page, you'll get a new username.
      </li>
      <li>You can invite anyone you'd like by just giving them the URL.</li>
      <li>
        You can create a room with any name you'd like by just plugging it
        into the URL. Anyone else can join that room too, though, by doing
        the same.
      </li>
    </ul>

    <a
      href={~p"/rooms"}
      class="inline-block rounded-[0.3rem] bg-[#007bff] px-4 py-2 text-xl text-white hover:bg-[#0069d9]"
    >
      Create a random room
    </a>
  </div>
</Layouts.app>
